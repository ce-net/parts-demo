{
  "name": "parts-demo-web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "The parts.demo page: built into web/dist/app.js, which the cell embeds",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && esbuild src/app.ts --bundle --format=esm --target=es2022 --minify --legal-comments=none --outfile=dist/app.js"
  },
  "dependencies": {
    "@ce-net/db": "git+https://github.com/ce-net/ce-db-ts.git#d40c88ce41b628a20eeaac5565e624aa5d13df51"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
