{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ce-net/db/web": [
        "./node_modules/@ce-net/db/dist/src/web"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../sdk/ts-web/**/*.ts"
  ]
}
